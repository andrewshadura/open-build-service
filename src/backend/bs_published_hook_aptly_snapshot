#!/usr/bin/perl
use strict;
use warnings;

# This script can be used as reference for creating snapshots on OBS
# publishing.
# This perl script will create and publish snapshots for all the related
# distributions suffixes, e.g: `v2022`, `v2022-security`, `v2022-updates`.

BEGIN {
  my ($wd) = $0 =~ m-(.*)/- ;
  $wd ||= '.';
  unshift @INC,  "$wd/build";
  unshift @INC,  "$wd";
}

use BSAptly;
use File::Basename;
use Getopt::Std;
use POSIX qw(strftime);

use vars qw ($opt_t);

sub distribution_basename {
  my ($distribution) = @_;
  my ($basename, $suffix) = $distribution =~ /(.*)-(.*)/;
  return $basename || $distribution;
}

sub do_distro_snapshot {
  my ($prefix, $distribution, $timestamp) = @_;
  my $distro_config = BSAptly::aptly_distro_get_config($prefix, $distribution);
  die("can't find aptly configuration for distribution $prefix/$distribution\n") if !$distro_config;
  BSAptly::aptly_distro_snapshot($prefix, $distribution, $timestamp);
  BSAptly::aptly_publish_snapshot($prefix, $distribution, $timestamp);
}

getopts('t:');

my ($projid, $repoid) = $ARGV[0] =~ /(.*)\/(.*)/;
my @suffixes = ('', '-security', '-updates');
my $timestamp = $opt_t || strftime "%Y%m%dT%H%M%SZ", gmtime;

die("bad project/repo parameter: $projid, $repoid\n") if !$projid || !$repoid;

my $distro_config = BSAptly::aptly_repo_get_config($projid, $repoid);
die("can't find related aptly distribution for $projid/$repoid\n") if !$distro_config;
my $prefix = $distro_config->{'prefix'};
my $distribution = distribution_basename($distro_config->{'distribution'});

my $rootDir = BSAptly::aptly_get_config('rootDir');
die("failed to read Aptly config rootDir\n") if !$rootDir;
my $distsDir = "$rootDir/public/$prefix/dists";

foreach my $suffix (@suffixes) {
  do_distro_snapshot($prefix, $distribution.$suffix, $timestamp);
  my $targetSnapshot = "$distsDir/".BSAptly::aptly_snapshot_gen_distro($distribution.$suffix, $timestamp);
  my $targetDir = dirname($targetSnapshot);
  if (! -d $targetDir) {
    warn("$targetDir doesn't exist, ignoring suffix $suffix\n");
    next;
  }
  my $linkName = "$distsDir/".BSAptly::aptly_snapshot_gen_distro($distribution.$suffix, 'latest');
  unlink($linkName);
  symlink($targetSnapshot, $linkName) or die("failed to create $linkName symlink to $targetSnapshot");
  open(FH, '>', "$linkName.txt") or die("failed to write $linkName.txt file: $!");
  print FH "$timestamp";
  close(FH);
}
