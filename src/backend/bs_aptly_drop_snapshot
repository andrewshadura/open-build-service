#!/usr/bin/perl
use strict;
use warnings;

# This script can be used as reference for dropping snapshots on OBS
# publishing.
# This perl script will unpublish and drop snapshots for all the related
# distributions suffixes, e.g: `v2022`, `v2022-security`, `v2022-updates`.

BEGIN {
  my ($wd) = $0 =~ m-(.*)/- ;
  $wd ||= '.';
  unshift @INC,  "$wd/build";
  unshift @INC,  "$wd";
}

use BSAptly;

sub distribution_basename {
  my ($distribution) = @_;
  my ($basename, $suffix) = $distribution =~ /(.*)-(.*)/;
  return $basename || $distribution;
}

sub drop_distro_snapshot {
  my ($prefix, $distribution, $timestamp) = @_;
  my $distro_config = BSAptly::aptly_distro_get_config($prefix, $distribution);
  my $snapshot_distro = BSAptly::aptly_snapshot_gen_distro($distribution, $timestamp);
  die("can't find aptly configuration for distribution $prefix/$snapshot_distro\n") if !$distro_config;
  if (!BSAptly::aptly_is_published($prefix, $snapshot_distro)) {
    die("$prefix $snapshot_distro not published\n");
  }
  BSAptly::aptly_unpublish_snapshot($prefix, $distribution, $timestamp);
  BSAptly::aptly_distro_snapshot_drop($prefix, $distribution, $timestamp);
}

my $prefix = $ARGV[0];
my $distro = $ARGV[1];
my $timestamp = $ARGV[2];
die("Usage: bs_aptly_drop_snapshot <prefix> <distro> <timestamp>\n") if !$prefix || !$distro || !$timestamp;

my $distro_config = BSAptly::aptly_distro_get_config($prefix, $distro);
die("Failed to get aptly configuration for prefix/distro: $prefix/$distro\n") if !$distro_config;

my @suffixes = ('', '-security', '-updates');

foreach my $suffix (@suffixes) {
  drop_distro_snapshot($prefix, $distro.$suffix, $timestamp);
}
