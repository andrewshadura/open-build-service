#!/usr/bin/perl
use strict;
use warnings;

# This script can be used to migrate reprepro repositories and snapshots to
# aptly.
#
# Before running this script, OBS configuration must be updated moving the
# repositories from reprepro backend to aptly.
#
# OBS services (srcserver and publisher) should be disabled before running this
# script and re-enabled afterwards:
#   $ supervisorctl [stop|start] srcserver
#   $ supervisorctl [stop|start] publisher
#
# Reprepro repositories and snapshots are not modified by this script. These
# should be cleaned up from the filesystem afterwards.

BEGIN {
  my ($wd) = $0 =~ m-(.*)/- ;
  $wd ||= '.';
  unshift @INC,  "$wd/build";
  unshift @INC,  "$wd";
}

use BSAptly;
use File::Basename;

use constant REPREPRO_ROOTDIR => '/srv/obs/repos';

sub aptly_migrate {
  # Migrate packages from reprepro distro/snapshot to aptly repository.
  my ($projid, $repoid, $component, $distrodir, $prefixdir) = @_;
  BSAptly::aptly_repo_clean($projid, $repoid);
  my @package_files = grep { -f } glob "$distrodir/$component/*/Packages";
  foreach my $package_file (@package_files) {
    open(FH, '<', $package_file) or die $!;
    while(<FH>) {
      if ($_ =~ /^Filename: (.*)$/) {
        my @args = ('repo', 'add', "$projid/$repoid", "$prefixdir/$1");
        BSAptly::aptly_exec(@args);
      }
    }
    close(FH);
  }
}

my $prefix = $ARGV[0];
my $distro = $ARGV[1];
die("Usage: bs_aptly_migration <prefix> <distro>\n") if !$prefix || !$distro;

my $distro_config = BSAptly::aptly_distro_get_config($prefix, $distro);
die("Failed to get aptly configuration for prefix/distro: $prefix/$distro\n") if !$distro_config;

my $reprepro_prefixdir = REPREPRO_ROOTDIR."/$prefix";
my $reprepro_distrodir = "$reprepro_prefixdir/dists/$distro";
my $reprepro_snapshotsdir = "$reprepro_distrodir/snapshots";

my $distro_components = $distro_config->{'components'};

print("Creating aptly repositories\n");
foreach my $component (keys %{ $distro_components }) {
  my $component_config = $distro_components->{$component};
  my $projid = $component_config->{'project'};
  my $repoid = $component_config->{'repository'};
  BSAptly::aptly_repo_create($projid, $repoid, $distro, $component);
}

my @snapshots = grep { -d && ! -l } glob "$reprepro_snapshotsdir/*";
foreach my $snapshotdir (@snapshots) {
  my $timestamp = basename($snapshotdir);
  print("Processing reprepro snapshot timestamp: $timestamp\n");
  foreach my $component (keys %{ $distro_components }) {
    my $component_config = $distro_components->{$component};
    my $projid = $component_config->{'project'};
    my $repoid = $component_config->{'repository'};
    aptly_migrate($projid, $repoid, $component, $snapshotdir, $reprepro_prefixdir);
  }
  BSAptly::aptly_distro_snapshot($prefix, $distro, $timestamp);
  BSAptly::aptly_publish_snapshot($prefix, $distro, $timestamp);
}

print("Processing reprepro repository\n");
foreach my $component (keys %{ $distro_components }) {
  my $component_config = $distro_components->{$component};
  my $projid = $component_config->{'project'};
  my $repoid = $component_config->{'repository'};
  aptly_migrate($projid, $repoid, $component, $reprepro_distrodir, $reprepro_prefixdir);
}

BSAptly::aptly_publish_repo($prefix, $distro);
