#!/usr/bin/perl
use strict;
use warnings;

# Aptly needs to regularly run a database cleanup to remove unused data.
# This script can be used as reference to run periodic jobs scheduled to
# clean the database.

BEGIN {
  my ($wd) = $0 =~ m-(.*)/- ;
  $wd ||= '.';
  unshift @INC,  "$wd/build";
  unshift @INC,  "$wd";
}

use BSAptly;

BSAptly::aptly_db_cleanup();
