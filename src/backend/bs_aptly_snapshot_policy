#!/usr/bin/perl
use strict;
use warnings;

# This script implements snapshot retention policy based on configuration files.
# Each YAML configuration file specifies:
#   * target prefix to be applied to.
#   * target distribution to be applied to, regex allowed.
#   * retention ranges:
#     * days_range: keep all snapshots in the past number <days_range> of days
#     * weeklies_range: keep weeklies snapshots (first snapshot of the week) for the past number <weeklies_range> of weeks
#     * monthlies_range: keep monthlies snapshots (first snapshot of the month) for the past number <monthlies_range> of month
#   * individual snapshots to keep:
#     * each entry in keep list must be of form 'distribution/timestamp', regex allowed.
# The script will drop any snapshot not covered by any of the defined policies.

BEGIN {
  my ($wd) = $0 =~ m-(.*)/- ;
  $wd ||= '.';
  unshift @INC,  "$wd/build";
  unshift @INC,  "$wd";
}

use BSAptly;
use Data::Dump qw(dump);
use DateTime;
use DateTime::Format::Duration;
use DateTime::Format::HTTP;
use Getopt::Std;
use YAML::Tiny;

use constant APTLY_POLICY_DIR => '/srv/obs/aptly/snapshot.policy.d';
use constant KEEP_SNAPSHOT => 0;
use constant DROP_SNAPSHOT => 1;

my $dry_run = 0;
my $verbose = 0;

sub debug {
  return print(@_) if $verbose;
}

sub format_timestamp {
  my ($timestamp) = @_;
  return $timestamp->strftime("%Y%m%dT%H%M%SZ");
}

sub parse_policy_file {
  my ($filename) = @_;
  my $yaml = YAML::Tiny->read($filename)->[0];
  my $ret = {
    days_range => 0,
    weeklies_range => 0,
    monthlies_range => 0,
    keep => {},
  };

  print("parsing YAML file: $filename\n");

  if (!$yaml->{prefix}) {
    warn("Failed to parse policy file $filename: prefix not found\n");
    return;
  }

  $ret->{prefix} = $yaml->{prefix};

  if ($yaml->{distribution}) {
    eval { '' =~ /$yaml->{distribution}/; };
    if ($@) {
      warn("Failed to parse policy file $filename: bad distribution regex: ".$yaml->{distribution}."\n");
      return;
    }
  } else {
    warn("Failed to parse policy file $filename: distribution not found\n");
    return;
  }

  $ret->{distribution} = $yaml->{distribution};

  if ($yaml->{retention}) {
    my $retention = $yaml->{retention};
    foreach ('days_range', 'weeklies_range', 'monthlies_range') {
      if ($retention->{$_}) {
        if ($retention->{$_} != int($retention->{$_})) {
          warn("Failed to parse policy file $filename: $_ not an integer\n");
          return;
        }
      }
      $ret->{$_} = int($retention->{$_}) || 0;
    }
    if ($retention->{keep}) {
      foreach my $k (@{ $retention->{keep} }) {
        eval { '' =~ /$k/; };
        if ($@) {
          warn("Failed to parse policy file $filename: bad regex in keep list: ".$k."\n");
          return;
        }
        if ($k =~ /^(.+)\/(.+)$/) {
          $ret->{keep}->{$1}->{$2} = 1;
	} else {
          warn("Failed to parse policy file $filename: $k in keep list must be of form 'distribution/timestamp'\n");
          return;
        }
      }
    }
  }

  return $ret;
}

sub policy_days {
  # keep all snapshots in the past number <range> of days
  my ($now, $timestamp, $range) = @_;
  $now = $now->clone->truncate(to => "day");
  $timestamp = $timestamp->clone->truncate(to => "day");
  my $delta = $now->delta_days($timestamp)->in_units('days');
  return $delta < $range;
}

sub policy_weeklies {
  # keep weeklies snapshots (first snapshot of the week) for the past number <range> of weeks
  my ($now, $timestamp, $range) = @_;
  $now = $now->clone->truncate(to => "week");
  $timestamp = $timestamp->clone->truncate(to => "week");
  my $delta = $now->delta_days($timestamp)->in_units('weeks');
  return $delta < $range;
}

sub policy_monthlies {
  # keep monthlies snapshots (first snapshot of the month) for the past number <range> of month
  my ($now, $timestamp, $range) = @_;
  $now = $now->clone->truncate(to => "month");
  $timestamp = $timestamp->clone->truncate(to => "month");
  my $delta = ($now - $timestamp)->delta_months;
  return $delta < $range;
}

sub policy_keep {
  # keep individual snapshots matching distribution/timestamp regex
  my ($distribution, $timestamp, $keep) = @_;
  foreach my $d (keys %{ $keep }) {
    next unless ($distribution =~ /^$d$/);
    foreach my $t (keys %{ $keep->{$d} }) {
      next unless ($timestamp =~ /^$t$/);
      return 1;
    }
  }
  return 0;
}

sub run_policy {
  my ($policy, $now, $input_file) = @_;

  my $prefix = $policy->{prefix};
  my $distribution_r = $policy->{distribution};
  my $target_r = "$prefix ".BSAptly::aptly_snapshot_gen_distro($distribution_r, '');

  my $days_range = $policy->{days_range};
  my $weeklies_range = $policy->{weeklies_range};
  my $monthlies_range = $policy->{monthlies_range};
  my $keep = $policy->{keep};

  my $snapshots = {};
  my $weeklies = {};
  my $monthlies = {};

  my $input_list;
  if ($input_file) {
    open(FH, '<', $input_file) or die("Failed to open $input_file: $!");
    $input_list = do { local $/; <FH> };
    close(FH);
  } else {
    $input_list = BSAptly::aptly_publish_list();
  }

  print("Running policy for prefix/distribution: $prefix $distribution_r\n");
  if ($verbose) {
    print("DEBUG: days/weeklies/monthlies ranges: $days_range/$weeklies_range/$monthlies_range\n");
    print("DEBUG: keep: ", dump($keep), "\n");
  }

  foreach my $snapshot (split(/\n/, $input_list)) {
    next unless $snapshot =~ /^$target_r.*$/;
    my $match = "$prefix ".BSAptly::aptly_snapshot_gen_distro('(.*)', '(.*)');
    if ($snapshot =~ /^$match$/) {
      my ($distribution, $timestamp) = ($1, $2);
      if (policy_keep($distribution, $timestamp, $keep)) {
        debug("DEBUG: keep policy: $distribution $timestamp\n");
        $snapshots->{$distribution}->{$timestamp} = KEEP_SNAPSHOT;
      } else {
        $snapshots->{$distribution}->{$timestamp} = DROP_SNAPSHOT;
      }
    } else {
      die("Failed to parse snapshot: $snapshot\n");
    }
  }

  if ($verbose) {
    print("DEBUG: snapshots: ", dump($snapshots), "\n");
  }

  foreach my $distribution (keys %{ $snapshots }) {
    my $timestamps = $snapshots->{$distribution};
    foreach my $timestamp (keys %{ $timestamps }) {
      my $t = DateTime::Format::HTTP->parse_datetime($timestamp);
      if (policy_days($now, $t, $days_range)) {
        debug("DEBUG: days policy: $distribution $timestamp\n");
        $snapshots->{$distribution}->{$timestamp} = KEEP_SNAPSHOT;
      }
      if (policy_weeklies($now, $t, $weeklies_range)) {
        push(@{ $weeklies->{$distribution}->{$t->week_year}{$t->week_number} }, $t);
      }
      if (policy_monthlies($now, $t, $monthlies_range)) {
        push(@{ $monthlies->{$distribution}->{$t->year}{$t->month} }, $t);
      }
    }
  }

  # Keep the first snapshot for each week
  foreach my $distribution (keys %{ $weeklies }) {
    my $week_years = $weeklies->{$distribution};
    foreach my $week_year (keys %{ $week_years }) {
      my $week_numbers = $week_years->{$week_year};
      foreach my $week_number (keys %{ $week_numbers }) {
        my $timestamps = $week_numbers->{$week_number};
        @{ $timestamps } = sort @{ $timestamps };
        my $t = format_timestamp($timestamps->[0]);
        debug("DEBUG: weeklies policy: $distribution $t\n");
        $snapshots->{$distribution}->{$t} = KEEP_SNAPSHOT;
      }
    }
  }

  # Keep the first snapshot for each month
  foreach my $distribution (keys %{ $monthlies }) {
    my $years = $monthlies->{$distribution};
    foreach my $year (keys %{ $years }) {
      my $months = $years->{$year};
      foreach my $month (keys %{ $months }) {
        my $timestamps = $months->{$month};
        @{ $timestamps } = sort @{ $timestamps };
        my $t = format_timestamp($timestamps->[0]);
        debug("DEBUG: monthlies policy: $distribution $t\n");
        $snapshots->{$distribution}->{$t} = KEEP_SNAPSHOT;
      }
    }
  }

  # Drop snapshots not retained by the policy
  foreach my $distribution (keys %{ $snapshots }) {
    my $timestamps = $snapshots->{$distribution};
    foreach my $timestamp (keys %{ $timestamps }) {
      if ($timestamps->{$timestamp} == DROP_SNAPSHOT) {
        print("INFO: dropping snapshot: $distribution $timestamp\n");
        if (!$dry_run) {
          BSAptly::aptly_unpublish_snapshot_check($prefix, $distribution, $timestamp);
          BSAptly::aptly_distro_snapshot_drop($prefix, $distribution, $timestamp);
        }
      }
    }
  }
}

our ($opt_c, $opt_h, $opt_i, $opt_r, $opt_t, $opt_v);
getopts('c:hi:rt:v');
if ($opt_h) {
  print("Usage: $0 [OPTIONS]\n");
  print("  OPTIONS:\n");
  print("    -c <PATH>:\t\tConfiguration files path (default: `".APTLY_POLICY_DIR."`)\n");
  print("    -h:\t\t\tPrint this help and exit\n");
  print("    -i <INPUT>:\t\tInput file with published snapshots list (e.g. `aptly publish list -raw` output)\n");
  print("    -r:\t\t\tDry run. Print the results without actually dropping snapshots\n");
  print("    -t <TIMESTAMP>:\tRun policy using TIMESTAMP as the current date timestamp (e.g. `20220530T135832Z`)\n");
  print("    -v:\t\t\tVerbose debug output\n");
  exit(1);
}
my $aptly_policy_dir = $opt_c || APTLY_POLICY_DIR;
my $input_file = $opt_i || "";
my $now = ($opt_t && DateTime::Format::HTTP->parse_datetime($opt_t)) || DateTime->now;

$dry_run = $opt_r || 0;
$verbose = $opt_v || 0;

foreach my $file (grep {/\.yaml$/} glob APTLY_POLICY_DIR."/*") {
  my $policy = parse_policy_file($file);
  if (!$policy) {
    warn("Omitting policy file $file\n");
    next;
  }
  if ($verbose) {
    print("DEBUG: parsed policy: ", dump($policy), "\n");
  }
  run_policy($policy, $now, $input_file);
}
