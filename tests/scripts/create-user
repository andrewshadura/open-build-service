#!/bin/sh -e

username="$1"
password="$2"

if [ -z "$username" ] || [ -z "$password" ]
then
	echo Both username and password must be specified. >&2
	exit 1
fi

prepare_userdata() {
	cat << EOF
<unregisteredperson>
	<login>$username</login>
	<realname>Sample User $username</realname>
	<email>$username@obs.example</email>
	<password>$password</password>
	<note></note>
	<state>confirmed</state>
</unregisteredperson>
EOF
}

echo "Checking if OBS user $username exists"
if osc api "/person/$username" > /dev/null
then
	echo "User already exists, updating the password"
	osc -H api -X POST -d "$password" "/person/$username?cmd=change_password"
	exit 0
fi

echo "Registering OBS user: $username"
osc -H api -X POST /person/register -d "$(prepare_userdata)"
