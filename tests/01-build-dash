#!/bin/sh

. $(dirname $0)/scripts/common.sh

set +x

TAP_FAIL_FATAL=1
trap tap_end EXIT

create-debian-project "$debian_release"
tap_ok $? "create $debian_release DoD"

create-project Debian:$debian_release:main/main $debian_release-derivative/main
tap_ok $? "create $debian_release-derivative"

apt-get source --download-only dash

tarball=$(echo dash_*.orig.tar.*)
# pretend the tarball is signed
echo signature > $tarball.asc

pkgver=${tarball%.orig.tar.*}
ver=${pkgver#dash_}

# create fake extra tarball
mkdir vendor
tar -zcf dash_$ver.orig-vendor.tar.gz vendor/

# pretend this is a valid signature
echo signature > dash_$ver.orig-vendor.tar.gz.asc

(
	dpkg-source -x *dsc
	cd dash-$ver
	dpkg-buildpackage -d -S
)

osc dput $debian_release-derivative *.dsc
tap_ok $? "upload dash to $debian_release-derivative"

cd "$OBSDIR"

if ! wait-for-pkg-state $debian_release-derivative dash main x86_64 5 building
then
	# DoD didn't wake up, restart the backend and try again
	echo "INFO: Packages haven't started building, restarting the backend." >&2
	docker-compose exec -T backend supervisorctl restart all
fi

wait-for-pkg $debian_release-derivative dash main x86_64
tap_ok $? "build dash"

wait-for-file -d storage/backend/repos/$debian_release-derivative/main
tap_ok $? "create repository $debian_release-derivative/main"

wait-for-file -f storage/backend/repos/$debian_release-derivative/main/$tarball
tap_ok $? "publish $tarball in $debian_release-derivative/main"

ls storage/backend/repos/$debian_release-derivative/main -lR

TAP_FAIL_FATAL=

for f in $tarball.asc dash_$ver.orig-vendor.tar.gz dash_$ver.orig-vendor.tar.gz.asc
do
	test -f storage/backend/repos/$debian_release-derivative/main/$f
	tap_ok $? "file $f present in the repository"
done
